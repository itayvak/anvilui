{
    "name": "anvilui",
    "version": "0.1.0",
    "description": "Material 3 style React components built on Base UI. Ships agent docs in AGENTS.md and docs/.",
    "author": "itayvak",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/index.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist",
        "bin",
        "docs",
        "AGENTS.md"
    ],
    "scripts": {
        "build": "tsup && tsc -p tsconfig.build.json",
        "dev": "tsup --watch",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "material-symbols": "^0.47.4"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/itayvak/anvilui.git",
        "directory": "core"
    },
    "homepage": "https://github.com/itayvak/anvilui#readme",
    "keywords": [
        "react",
        "components",
        "ui",
        "material",
        "base-ui",
        "design-system"
    ],
    "bin": {
        "anvilui": "./bin/anvilui.mjs"
    }
}
