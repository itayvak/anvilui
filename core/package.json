{
    "name": "anvilui",
    "version": "0.1.0",
    "description": "Anvil UI",
    "author": "itayvak",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/index.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && tsc -p tsconfig.build.json",
        "dev": "tsup --watch",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "material-symbols": "^0.47.4"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    }
}
